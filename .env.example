# PostgreSQL (Neon) — ჩასვით თქვენი connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# API სერვერის პორტი
PORT=3001

# ატვირთული მედიის საქაღალდე (Railway-ზე ავტომატურად იყენებს /storage volume-ს)
STORAGE_DIR=

# Discord OAuth (რეგისტრაციისთვის — Discord Developer Portal-იდან)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# საწყისი ადმინის ანგარიში (პაროლი ბაზაში მხოლოდ scrypt ჰეშად ჩაიწერება)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# RedM ლაივ სტატუსი — ჰეროზე რეალური მოთამაშეების რაოდენობისთვის მიუთითეთ ერთ-ერთი:
# პირდაპირი მისამართი (სერვერის IP + პორტი, ჩვეულებრივ 30120):
REDM_SERVER_URL=
# ან cfx.re join კოდი (მაგ. https://cfx.re/join/abc123 → abc123):
REDM_CFX_CODE=
